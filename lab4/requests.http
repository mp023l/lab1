# Запускать Run All Requests по порядку. Cookie jar должен быть включён.
# Укажите пароль администратора, заданный при первом запуске.
@baseUrl = http://localhost:8080
@adminPassword = AdminDemo123!
@password = AuctionUser123!

### 01 Получить CSRF и cookie
< {%
 const run=Date.now().toString();
 client.global.set('run',run);
 ['seller','buyer','other'].forEach(x=>client.global.set(x+'Name',x+run));
 client.global.set('start',new Date(Date.now()-60000).toISOString());
 client.global.set('end',new Date(Date.now()+3600000).toISOString());
 %}
GET {{baseUrl}}/api/security/csrf

> {%
 client.test("01 Получить CSRF и cookie",function(){client.assert(response.status===200,'Expected 200, got '+response.status);});
 client.global.set("csrf",response.body["token"]);
 %}

### Без входа — 401
GET {{baseUrl}}/api/auction-lots

> {%
 client.test("Без входа — 401",function(){client.assert(response.status===401,'Expected 401, got '+response.status);});
 %}

### Регистрация seller
POST {{baseUrl}}/api/security/register
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "username": "{{sellerName}}",
  "name": "seller",
  "email": "{{sellerName}}@example.com",
  "password": "{{password}}",
  "role": "ADMIN"
}

> {%
 client.test("Регистрация seller",function(){client.assert(response.status===201,'Expected 201, got '+response.status);});
 client.global.set("sellerId",response.body["id"]);
 %}

### Регистрация buyer
POST {{baseUrl}}/api/security/register
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "username": "{{buyerName}}",
  "name": "buyer",
  "email": "{{buyerName}}@example.com",
  "password": "{{password}}",
  "role": "ADMIN"
}

> {%
 client.test("Регистрация buyer",function(){client.assert(response.status===201,'Expected 201, got '+response.status);});
 client.global.set("buyerId",response.body["id"]);
 %}

