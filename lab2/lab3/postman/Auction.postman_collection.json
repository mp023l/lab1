      "name": "01. Создать продавца",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Продавец\", \"email\": \"seller-{{run}}@example.org\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run\", Date.now()+\"-\"+Math.floor(Math.random()*100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code === 201) pm.collectionVariables.set(\"seller\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
